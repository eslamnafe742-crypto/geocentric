#!/usr/bin/env python3
# Find gears that share common axles
# For epicyclic gears the ratios are all weird!
# BUT none of this matters...
#
# no reverser since we want to subtract from the already moving carrier
#
# Stage one is simple math: wp1 = ns1 / np1 (small sun, big planet)
# Stage two is also simple: ws2 = 1 - np2 / ns2 * wp1
#
from math import fabs
max_total_teeth = 100
min_teeth = 12

target = 1 - (360 - (360 / 29.5306)) / 360
print(target)

wc1 = 1
wc2 = wc1 # it goes backwards from the perspective of the lpanetary gear


for total_teeth in range(min_teeth*2, max_total_teeth):
	for ns1 in range(min_teeth, total_teeth - min_teeth):
		# this first epicyclic gear has a fixed sun,
		# and driven carrier

		# intermediate gear
		for np1 in [total_teeth - ns1]: #range(min_teeth, total_teeth - min_teeth - ns1):
	#		nr1 = total_teeth - 2*np1 - ns1
	#		if nr1< min_teeth:
	#			continue

			# np1 does not enter into gear ratio
			# since the the "ring gear" is driving
			# the next stage
			#wp = (ns1 + nr1) / nr1 * wc1
			wp = ns1 / np1 * wc1

			for np2 in range(min_teeth, total_teeth - min_teeth):
				# this is a *second* epicyclic set,
				# but the planet and carrier are both driven,
				# so we want to compute it's sun gear speed
				# assume carrier speed wc = -1
				# wp = ra
				ns2 = total_teeth - np2
				ws2 = np2 / ns2 * wp

				print("%.6f %.6f %.6f t=%3d | %3d %3d | %3d %3d" % (fabs(target - ws2), ws2, wp, total_teeth, ns1, np1, ns2, np2))
			
